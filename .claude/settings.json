{
  "permissions": {
    "additionalDirectories": ["../wizard-app-planning", "../wizard-backend"],
    "allow": [
      "Read(../wizard-app-planning/**)",
      "Read(../wizard-backend/**)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh api user:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)"
