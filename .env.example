# 앱이 붙을 Supabase (16-architecture 12장). 이 파일만 커밋한다. .env, .env.dev는 커밋하지 않는다
#
# local: pnpm db:start → pnpm env:local  (.env를 자동으로 만든다. 손으로 채우지 않음)
# dev:   이 파일을 .env.dev로 복사해 wizard-dev 대시보드 값을 채운 뒤 → pnpm env:dev
# 바꾼 뒤에는 Metro를 다시 켠다: npx expo start --dev-client --clear
#
# EXPO_PUBLIC_ 값은 앱 번들에 그대로 들어간다.
# 키는 anon(또는 sb_publishable_) 키만. service_role·secret 키를 넣으면 검사에서 실패한다

# local | dev | alpha
EXPO_PUBLIC_APP_ENV=dev
# 대시보드 Project Settings > API의 Project URL (https://<ref>.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=
# 대시보드 API Keys의 anon(public) 또는 publishable 키
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# local·dev: true / alpha: false
EXPO_PUBLIC_ENABLE_EMAIL_LOGIN=true
